# Bu dosya, deponuzun nasıl kaynak gösterileceğini tanımlar.
# GitHub bu dosyayı otomatik okur ve depo sayfasında
# "Cite this repository" düğmesi gösterir.
#
# Köşeli parantez içindeki alanları kendi bilgilerinizle doldurun,
# sonra köşeli parantezleri silin.
#
# Doğrulamak için: pip install cffconvert && cffconvert --validate

cff-version: 1.2.0
message: "Bu çalışmayı kullanırsanız lütfen aşağıdaki gibi kaynak gösterin."

title: "[Proje adınız]"
